# Local dev (embedded-postgres on this VM)
DATABASE_URL="postgresql://hrms:hrms@localhost:5433/hrms?schema=public"
# Production example (managed Postgres)
# DATABASE_URL="postgresql://user:password@host:5432/hrms?schema=public"
# REQUIRED. No default: the API refuses to start if this is missing or a
# known default value. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET="replace-me-with-a-random-64-hex-char-secret"
# NOTE: JWT_REFRESH_SECRET is intentionally NOT listed. It was verified dead
# on 2026-10-21: the refresh flow uses opaque random tokens (randomBytes +
# SHA-256 hash in auth.service.ts) and no code reads this variable, so it
# was removed rather than enforced.
# REQUIRED in production (32 bytes as 64 hex chars); used for AES-256-GCM
# encryption of Employee.bankDetails at rest. The API refuses to start in
# production without a valid key. Generate the same way as JWT_ACCESS_SECRET.
# WARNING: losing this key makes all stored bank details unrecoverable —
# back it up in the deployment's secret store, never in the repo.
BANK_ENCRYPTION_KEY="replace-me-with-a-random-64-hex-char-key"
JWT_ACCESS_TTL="900"
JWT_REFRESH_TTL="2592000"
PORT="4000"
FRONTEND_URL="http://localhost:3000"
# Optional: password-reset email (nodemailer SMTP). When SMTP_HOST and
# SMTP_FROM are set, forgot-password sends a real reset email; when they are
# not set, forgot-password returns 503 email_not_configured and the MD/HR
# admin password reset remains the working path.
# SMTP_HOST=""
# SMTP_PORT="587"
# SMTP_USER=""
# SMTP_PASS=""
# SMTP_FROM=""
